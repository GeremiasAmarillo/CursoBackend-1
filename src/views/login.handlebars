<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <style>
      /* Estilo general */ body { display: flex; flex-direction: column;
      justify-content: center; align-items: center; min-height: 100vh; margin:
      0; font-family: 'Arial', sans-serif; background-color: #212121; color:
      #fff; } /* Encabezado */ header { width: 100%; background-color: #000;
      padding: 10px 0; text-align: center; } header h1 { font-size: 2rem;
      margin: 0; color: #ff9800; } /* Título de la página */ .page-title {
      text-align: center; color: #ff9800; margin: 20px 0; font-size: 1.5rem; }
      /* Sección principal */ main { background-color: #333; padding: 30px;
      border-radius: 8px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); width: 100%;
      max-width: 400px; } /* Estilos del formulario */ form { display: flex;
      flex-direction: column; } form div { margin-bottom: 15px; } label {
      display: block; margin-bottom: 5px; font-weight: bold; color: #ff9800; }
      input[type="email"], input[type="password"] { width: 100%; padding: 10px;
      border: 1px solid #444; border-radius: 4px; box-sizing: border-box;
      font-size: 1rem; background-color: #555; color: #fff; }
      input[type="email"]:focus, input[type="password"]:focus { border-color:
      #ff9800; outline: none; } button[type="submit"] { background-color:
      #ff9800; color: #fff; padding: 10px; border: none; border-radius: 4px;
      cursor: pointer; font-size: 1rem; } button[type="submit"]:hover {
      background-color: #e68900; } /* Estilo del enlace de registro */ p {
      text-align: center; color: #fff; } a { color: #ff9800; text-decoration:
      none; } a:hover { text-decoration: underline; } /* Estilos del botón de
      GitHub */ .github-container { text-align: center; margin-top: 20px; }
      .github-login { background-color: #000; color: #fff; padding: 10px 20px;
      border: none; border-radius: 4px; cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center; gap: 10px; }
      .github-login i { font-size: 1.2rem; } .github-login:hover {
      background-color: #333; }
    </style>
  </head>
  <body>
    <header>
      <h1>Login</h1>
    </header>

    <div class="page-title">Inicia sesión para acceder a tu cuenta</div>

    <main>
      <section>
        <form action="/login" method="post">
          <div>
            <label for="email">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              autocomplete="off"
              required
            />
          </div>
          <div>
            <label for="password">Contraseña</label>
            <input type="password" name="password" id="password" required />
          </div>

          <div>
            <button type="submit">Login</button>
          </div>
        </form>
        <div class="github-container">
          <a href="/github">
            <button type="button" class="github-login">
              <i class="fab fa-github"></i>
              Login with GitHub
            </button>
          </a>
        </div>
        <p>No tiene una cuenta? <a href="/register"> Registrate </a></p>
      </section>
    </main>

    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
  </body>
</html>