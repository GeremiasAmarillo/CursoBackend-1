<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <style>
      header { background-color: #333; color: #fff; padding: 10px 0; }
      .header-container { max-width: 1200px; margin: 0 auto; padding: 0 20px;
      display: flex; align-items: center; justify-content: space-between; } h1 {
      font-size: 24px; margin: 0; } .navbar { display: flex; align-items:
      center; gap: 20px; } .nav-link { color: #fff; text-decoration: none;
      padding: 8px 15px; border-radius: 5px; transition: background-color 0.3s,
      color 0.3s; } .nav-link:hover { background-color: #f57c00; color: #fff;
      .welcome-message { margin: 0; font-size: 18px; } .avatar-de-github {
      display: flex; align-items: center; } .avatar-de-github img { width: 40px;
      height: 40px; border-radius: 50%; border: 2px solid #fff; margin-left:
      10px; }
    </style>
  </head>
  <body>
    <header>
      <div class="header-container">
        <h1>{{title}}</h1>
        <nav class="navbar">
          {{#if user}}
            <p class="welcome-message">Bienvenido, {{user.email}}</p>
            <a href="/logout" class="nav-link">Cerrar sesión</a>

            {{#if user.avatar}}
              <div class="avatar-de-github">
                <img src="{{user.avatar}}" alt="Imagen de usuario de github" />
              </div>
            {{/if}}
          {{else}}
            <a href="/login" class="nav-link">Iniciar sesión</a>
            <a href="/register" class="nav-link">Registrarse</a>
          {{/if}}
          <a href="/chat" class="nav-link">Chat</a>
          <a href="/realtimeproducts" class="nav-link">Productos en Tiempo Real</a>
          <a href="/cart/66ba8f5329bdbe14c36848ed" class="nav-link">Carrito</a>
          <a href="/products" class="nav-link">Productos</a>
        </nav>
      </div>
    </header>
  </body>
</html>